---
// SOURCE: zurp-astronomics-site — catalog tile: the product poster, uncropped, with a one-line caption
// AUTHOR: engineer
// DATE: 2026-10-03
// STATUS: active
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  tagline: string;
  href: string;
  poster: ImageMetadata;
  posterAlt: string;
  accent: string;
}

const { name, tagline, href, poster, posterAlt, accent } = Astro.props;
---

<a class="card" href={href} style={`--card-accent: ${accent}`}>
  <!-- Square frame, no cropping: the poster carries text (name, slogan, signature) to its edges.
       Tiles never get a variant wider than 600 px (weight budget); `sizes` is capped to match. -->
  <Image
    src={poster}
    alt={posterAlt}
    widths={[320, 480, 600]}
    sizes="(max-width: 640px) min(calc(100vw - 3rem), 600px), (max-width: 1100px) 45vw, 340px"
    format="webp"
    quality={80}
    class="poster"
  />
  <p class="caption"><strong>{name}</strong> — {tagline}</p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper);
    color: var(--ink);
    border: var(--rule);
    box-shadow: 6px 6px 0 var(--ink);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover,
  .card:focus-visible {
    opacity: 1;
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--card-accent);
  }

  .card:focus-visible {
    outline: 3px solid var(--card-accent);
    outline-offset: 3px;
  }

  .poster {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
  }

  .caption {
    padding: 0.9rem 1rem 1rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink-muted);
    border-top: 6px solid var(--card-accent);
  }

  .caption strong {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
</style>
