---
// SOURCE: zurp-astronomics-site — /alternate/ catalog tile: a series 2 poster hung on the soot wall, with a label strip
// AUTHOR: engineer
// DATE: 2026-10-03
// STATUS: active
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  tagline: string;
  href: string;
  poster: ImageMetadata;
  posterAlt: string;
  accent: string;
}

const { name, tagline, href, poster, posterAlt, accent } = Astro.props;
---

<a class="tile" href={href} style={`--tile-accent: ${accent}`}>
  <!-- Whole poster, never cropped: name, slogan and signature run to the plate's edge. Its
       near-black corners are opaque pixels; the soot ground absorbs them, and the 5 % radius only
       trims that dark margin (the plate's own rounded corner starts further in).
       Weight budget: no variant wider than 600 px, `width` pins the fallback src at 600 too. -->
  <Image
    src={poster}
    alt={posterAlt}
    width={600}
    widths={[320, 480, 600]}
    sizes="(max-width: 640px) min(calc(100vw - 2rem), 600px), (max-width: 1100px) 45vw, 350px"
    format="webp"
    quality={78}
    class="poster"
  />
  <span class="label">
    <span class="rule" aria-hidden="true"></span>
    <strong class="name">{name}</strong>
    <span class="tagline">{tagline}</span>
  </span>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--z2-cream);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .poster {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: 5%;
    background: var(--z2-soot);
    transition: box-shadow 0.2s ease, filter 0.2s ease;
    filter: saturate(0.92) contrast(1.02);
  }

  /* A label strip screwed under the plate: black band, accent rule, cream text. */
  .label {
    position: relative;
    display: block;
    flex: 1;
    margin: -0.4rem 0.6rem 0;
    padding: 1.1rem 1rem 1rem;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.045) 0 1px, transparent 1.6px) 0 0 / 5px 5px,
      var(--z2-soot-deep);
    border: 1px solid rgba(236, 223, 191, 0.12);
    border-top: 0;
    clip-path: polygon(0 0, 100% 0, 100% 92%, 97% 100%, 62% 97%, 30% 100%, 3% 98%, 0 90%);
  }

  .rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 0.4rem;
    height: 4px;
    background: var(--tile-accent);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.5);
  }

  .name {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--z2-font-display);
    font-weight: 400;
    font-size: 1.35rem;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--z2-cream-light);
    text-shadow: 1.5px 1px 0 color-mix(in srgb, var(--tile-accent) 55%, transparent);
  }

  .tagline {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.93rem;
    line-height: 1.45;
    color: var(--z2-cream-dim);
  }

  .tile:hover,
  .tile:focus-visible {
    transform: translateY(-4px) rotate(-0.6deg);
  }

  .tile:hover .poster,
  .tile:focus-visible .poster {
    filter: none;
    box-shadow: 0 0 0 3px var(--z2-soot), 0 0 0 6px var(--tile-accent);
  }

  .tile:focus-visible {
    outline: 3px dashed var(--z2-cream);
    outline-offset: 6px;
  }
</style>
