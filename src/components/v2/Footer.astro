---
// SOURCE: zurp-astronomics-site — main site (v2) footer: the v1 footer copy (jokes) on a black band
// AUTHOR: engineer
// DATE: 2026-10-03
// STATUS: active
//
// The copy is the v1 footer's, word for word (v1 archive: src/pages/alternate/index.astro and
// src/pages/alternate/[slug]/index.astro): home line without a product, product line with one.
// The "Low-Tech & DIY" panel (the worn version, src/assets/header/low-tech-diy-poster.webp) signs
// the footer of EVERY page of the main site, home included, small (~140 px, the size of the v1
// sticker). Ticket #14 had left it out of the home page (its header shows the same poster full
// size); the human found the gap odd, and ticket #16 put it back: do not reintroduce a condition on
// `productName` here, which only picks the footer's copy line. The old flat sticker
// (public/Low_tech_DIY.png) stays with the v1 archive. Variants at 140 and 280 px (1x / 2x) only:
// it is never displayed wider. The only other addition to the v1 copy is the discreet "v1" link to
// the archive under /alternate/ — the one bridge between the two versions (v1 must never link back
// here).
import { Image } from 'astro:assets';
import lowTechPoster from '../../assets/header/low-tech-diy-poster.webp';

interface Props {
  productName?: string;
}

const { productName } = Astro.props;
---

<footer class="foot">
  <div class="z2-container foot-inner">
    <p class="z2-signature foot-sig" aria-hidden="true"><span>zUrp Astronomics</span></p>
    <p class="org-link">
      GitHub · <a href="https://github.com/zUrp-Astronomics">@zUrp-Astronomics</a>
    </p>
    {
      productName ? (
        <p>
          <em>{productName} — a product of zUrp Astronomics, a subsidiary of zUrp Industries.</em>
        </p>
      ) : (
        <p>
          <em>zUrp Astronomics — a subsidiary of zUrp Industries.</em>
        </p>
      )
    }
    <p class="legalese">
      Built with <a href="https://astro.build">Astro</a>, ~1&nbsp;MB of bash, and stubbornness.
      Hosted on GitHub Pages because the cloud is just someone else's keiretsu.
    </p>
    <Image
      src={lowTechPoster}
      alt="Small worn, creased “Low-Tech & DIY” panel: a riveted Nyan Cat trailing a pixel rainbow in front of a moon, on a blueprint with red rays."
      title="Low-Tech & DIY — culture zUrp"
      width={140}
      widths={[140, 280]}
      sizes="140px"
      format="webp"
      quality={72}
      loading="lazy"
      class="lowtech-panel"
    />
    <p class="v1-link"><a href="/alternate/">v1</a></p>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    margin-top: 5rem;
    padding: 3.25rem 0 2.5rem;
    text-align: center;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.05) 0 1px, transparent 1.6px) 0 0 / 5px 5px,
      var(--z2-soot-deep);
    border-top: 4px solid var(--z2-red);
    box-shadow: 0 -8px 0 var(--z2-soot-deep), 0 -10px 0 var(--z2-red);
  }

  .foot-inner {
    max-width: 760px;
  }

  .foot-sig {
    justify-content: center;
    color: var(--z2-cream);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
  }

  .foot p {
    color: var(--z2-cream-dim);
    font-size: 0.92rem;
    margin-bottom: 0.75rem;
  }

  .foot .foot-sig {
    color: var(--z2-cream);
  }

  .org-link {
    font-family: var(--z2-font-type);
    letter-spacing: 0.05em;
  }

  .org-link a {
    color: var(--z2-cream);
  }

  .legalese {
    font-size: 0.82rem !important;
  }

  /* Footer signature, not a second poster: dimmed and slightly askew on the black band, it lights
     up and straightens a little on hover (the v1 sticker's gesture, kept discreet). */
  .lowtech-panel {
    display: block;
    width: 140px;
    max-width: 100%;
    height: auto;
    margin: 1.75rem auto 0;
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgba(236, 223, 191, 0.12), 0 6px 14px rgba(0, 0, 0, 0.55);
    opacity: 0.7;
    filter: saturate(0.85);
    transform: rotate(-2deg);
    transition: opacity 0.2s ease, filter 0.2s ease, transform 0.2s ease;
  }

  .lowtech-panel:hover {
    opacity: 1;
    filter: none;
    transform: scale(1.1) rotate(1deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .lowtech-panel,
    .lowtech-panel:hover {
      transition: none;
      transform: rotate(-2deg);
    }
  }

  .foot .v1-link {
    margin: 1.75rem 0 0;
    font-family: var(--z2-font-type);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .v1-link a {
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
  }
</style>
