---
// SOURCE: zurp-astronomics-site — the main site's (v2) common header: photographed zUrp plate, subtitle, hairline; sticky, shadowed, condensed on scroll
// AUTHOR: engineer
// DATE: 2026-10-03
// STATUS: active
//
// Tickets #27, #29. Rendered by V2Layout.astro on EVERY v2 page (home `/` and the product pages
// `/<slug>/`), never by a page itself. Everything above the hairline, hairline included, is the
// header: the plate (src/assets/header/zurp-astronomics-plate.webp, a link to `/`), the subtitle
// "Because buying is cheating." and the rule. It stays visible while scrolling (position: sticky
// on a direct child of <body>: it keeps its own room in the flow, so nothing is ever hidden under
// it on load), on an opaque band of the wall with a soft drop shadow under it.
//
// Two sizes:
//   - full    — top of the home page only: plate 440 px max (300 px on phones), as before #27;
//   - compact — once the home page is really scrolled down, and from the start on product pages:
//               plate 168 px (120 px on phones), small subtitle; ≈ 98 px high on desktop, ≈ 71.5 px
//               on phones (budget from the architect: 100 / 72 px max).
// The switch is a small script (scroll listener, one rAF per frame, no dependency), with two
// DISTINCT thresholds (ticket #29, hysteresis — no flip-flop around a single line is possible):
//   - condense when the page has scrolled past the bottom of the subtitle "Because buying is
//     cheating." (it has gone under the top of the screen): by computation from the CSS
//     ≈ 226 px on desktop, ≈ 170 px on a 375 px phone (subtitle on two lines), i.e. well over half
//     the full header's height. Measured by the script on the full-size header (at load, on
//     resize, after each return to full size), never less than EXPAND_AT + 64 px;
//   - return to full size only back at the very top: scrollY ≤ 16 px (EXPAND_AT).
// Without JavaScript the home header stays full size and simply scrolls away (not sticky:
// `.is-sticky` is set by the script), product pages are compact and sticky in plain CSS.
// Every property the condensation animates (bar padding, plate width and shadow, subtitle margin,
// size and line height, rule margin, the bar's darkening) shares ONE duration and ONE curve:
// 0.8 s ease-in-out (`--site-head-motion`), so it moves as a single piece. The architect's call,
// approved by the human (ticket #29): not 2 s, which would leave the bar moving while one reads
// the catalog. Under prefers-reduced-motion the change is instant.
//
// Texture (ticket #29): the bar is a band of the page's wall — the same concrete mottling, dot
// screen, gallery light and blueprint grid as the page ground (`--z2-wall-*` in V2Layout.astro),
// anchored at the page's top-left corner like the page's, so at the top of the home page the bar
// and the wall line up. Compact, a dark wash (`.site-head-bar::before`) fades in over that
// texture: a slightly darker band of the same wall, with its drop shadow. The global grain
// (body::after) stays over everything.
//
// Why an outer box and an inner bar: when the home header condenses, the outer box (sticky,
// transparent, pointer-events: none) keeps the full header's height in the flow (the script locks
// its min-height), and only the inner bar shrinks. So the page below never jumps when the header
// changes size — no reflow, no scroll feedback loop — and the content simply slides under the bar.
//
// h1 semantics (ticket #27, deliberate): on the home page the plate IS the page's h1, as before;
// on a product page the h1 is the product name (visually hidden, in src/pages/[slug]/index.astro)
// and the plate sits in a plain <div>. One h1 per page.
import { Image } from 'astro:assets';
import plate from '../../assets/header/zurp-astronomics-plate.webp';

interface Props {
  /** Home page: full size at the top, condenses on scroll, the plate is the h1. */
  home?: boolean;
}

const { home = false } = Astro.props;
const Title = home ? 'h1' : 'div';
---

<header class:list={['site-head', { 'is-compact': !home }]} data-condense={home ? '' : undefined}>
  <div class="site-head-bar">
    <div class="z2-container site-head-inner">
      <!-- The plate is a real enamel plate, photographed (screws, rust and chips are in the image,
           so no CSS frame around it), hung straight. 1x/2x variants up to 880 px. -->
      <Title class="site-head-title">
        <a
          class="site-head-home"
          href="/"
          aria-label="zUrp Astronomics — home"
          aria-current={home ? 'page' : undefined}
        >
          <Image
            src={plate}
            alt="zUrp Astronomics"
            width={880}
            widths={[300, 440, 600, 880]}
            sizes={home ? '(max-width: 640px) min(82vw, 300px), 440px' : '(max-width: 640px) 120px, 168px'}
            format="webp"
            quality={80}
            loading="eager"
            class="site-head-plate"
          />
        </a>
      </Title>

      <!-- The subtitle: part of the title block, not of the h1 (the plate stays alone in it). -->
      <p class="site-head-subtitle">Because buying is cheating.</p>

      <!-- The hairline closes the header. Decorative only. -->
      <hr class="site-head-rule" aria-hidden="true" />
    </div>
  </div>
</header>

<script>
  // Home page only: condense the header once the page is really scrolled down, back to full size
  // only at the very top. Two distinct thresholds (hysteresis, ticket #29): between them the header
  // keeps whatever size it has, so no back-and-forth around one line is possible.
  const head = document.querySelector<HTMLElement>('.site-head[data-condense]');
  if (head) {
    const EXPAND_AT = 16; // px: back to full size at the top of the page, or nearly
    const MIN_GAP = 64; // px: the condense threshold never comes closer to EXPAND_AT than this
    const subtitle = head.querySelector<HTMLElement>('.site-head-subtitle')!;
    const plateLink = head.querySelector<HTMLElement>('.site-head-home')!;
    let condenseAt = 0;

    // Condense threshold: the scroll at which the subtitle's bottom edge passes under the top of the
    // screen. The header is the first thing on the page (document top 0), so that is the subtitle's
    // bottom inside the header, whatever the header is doing. Only measured on the full-size header.
    const measure = () => {
      if (head.classList.contains('is-compact')) return;
      const offset = subtitle.getBoundingClientRect().bottom - head.getBoundingClientRect().top;
      condenseAt = Math.max(Math.round(offset), EXPAND_AT + MIN_GAP);
    };

    // Keep the full header's height in the flow while it is (or is becoming) compact: the bar
    // shrinks inside it, the page below does not move.
    const release = () => {
      if (head.classList.contains('is-compact')) return;
      head.style.minHeight = '';
      measure();
    };
    const animates = () =>
      getComputedStyle(plateLink).transitionDuration.split(',').some((d) => parseFloat(d) > 0);

    const setCompact = (compact: boolean) => {
      if (compact === head.classList.contains('is-compact')) return;
      if (compact) head.style.minHeight = `${head.offsetHeight}px`;
      head.classList.toggle('is-compact', compact);
      // No transition to wait for (reduced motion): release at once.
      if (!compact && !animates()) release();
    };

    const update = () => {
      const y = window.scrollY;
      if (y > condenseAt) setCompact(true);
      else if (y <= EXPAND_AT) setCompact(false);
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    head.addEventListener('transitionend', (event) => {
      if (event.target === plateLink && event.propertyName === 'width') release();
    });
    window.addEventListener('resize', () => {
      release();
      update();
    });
    window.addEventListener('scroll', onScroll, { passive: true });

    head.classList.add('is-sticky');
    measure();
    update();
  }
</script>

<style is:global>
  /*
   * Global (under html.z2) on purpose: the script adds `.is-sticky` / `.is-compact` at run time;
   * everything stays under html.z2, out of the v1 archive's reach.
   */

  /* Anchor jumps and focus scrolling land below the compact header, never under it. (The footer's
     "back to top" link targets <body id="top">: it lands at 0, where the home header is full size.) */
  html.z2 {
    scroll-padding-top: 7rem;
  }

  /* The outer box: sticky, transparent, lets clicks through (it may be taller than the bar while
     the home header is compact, see the script). Sticky works because it is a direct child of
     <body> and <body>'s `overflow-x: hidden` is propagated to the viewport (html.z2 sets no
     overflow), so no ancestor clips it. Under the grain overlay (body::after, z-index 50) so the
     header is printed on the same paper as the rest, under the build stamp (100). */
  html.z2 .site-head {
    /* One duration, one curve for everything the condensation animates (ticket #29). */
    --site-head-motion: 0.8s ease-in-out;
    position: relative;
    z-index: 40;
    pointer-events: none;
  }

  html.z2 .site-head.is-compact,
  html.z2 .site-head.is-sticky {
    position: sticky;
    top: 0;
  }

  /* The bar: a band of the page's wall itself (opaque) — the same layers as the page ground
     (V2Layout.astro, `--z2-wall-*`), anchored like them at the page's top-left corner, so at the
     top of the page it lines up with the wall around it — and a soft shadow cast under it: relief,
     not a halo. Isolated so its dark wash (::before) sits between its ground and its content. */
  html.z2 .site-head-bar {
    position: relative;
    isolation: isolate;
    pointer-events: auto;
    background:
      var(--z2-wall-light),
      var(--z2-wall-concrete),
      var(--z2-wall-dots),
      var(--z2-wall-grid),
      var(--z2-soot);
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.35),
      0 6px 12px -4px rgba(0, 0, 0, 0.55);
    padding-top: 2.75rem;
    transition: padding var(--site-head-motion);
  }

  /* The compact bar's darkening: a wash of deep soot over the wall's texture (which still shows
     through), faded in with the rest of the condensation. */
  html.z2 .site-head-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(16, 15, 14, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--site-head-motion);
  }

  html.z2 .site-head-inner {
    text-align: center;
  }

  html.z2 .site-head-title {
    margin: 0;
    line-height: 0;
  }

  /* The plate: 440 px at most, hung straight, the shadow of a plate standing off a wall. The link
     carries the size, so the image only fills it. */
  html.z2 .site-head-home {
    display: block;
    width: min(100%, 440px);
    margin: 0 auto;
    text-decoration: none;
    border-radius: 6px;
    transition: width var(--site-head-motion);
  }

  html.z2 .site-head-plate {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 1;
    border-radius: 6px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.6),
      5px 8px 14px rgba(0, 0, 0, 0.55);
    transition: box-shadow var(--site-head-motion);
  }

  /* The subtitle: the posters' slogan type (Archivo 800, 125 % wide, cream capitals, wide
     tracking) without its black band. Never wider than the plate at full size. */
  html.z2 .site-head-subtitle {
    width: min(100%, 440px);
    margin: 0.85rem auto 0;
    /* The trailing tracking would push the line off-centre: balance it on the left. */
    padding-left: 0.24em;
    color: var(--z2-cream);
    font-family: var(--z2-font-body);
    font-weight: 800;
    font-stretch: 125%;
    font-size: 0.9rem;
    line-height: 1.5;
    letter-spacing: 0.24em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
    transition:
      margin var(--site-head-motion),
      font-size var(--site-head-motion),
      line-height var(--site-head-motion);
  }

  /* The hairline, across the container, in the page's cream, dimmed: the header's lower edge. */
  html.z2 .site-head-rule {
    height: 0;
    margin: 2.5rem 0 0;
    border: 0;
    border-top: 1px solid var(--z2-cream-dim);
    opacity: 0.35;
    transition: margin var(--site-head-motion);
  }

  /* --- Compact ------------------------------------------------------------------------------ */

  html.z2 .site-head.is-compact .site-head-bar {
    padding-top: 0.7rem;
  }

  html.z2 .site-head.is-compact .site-head-bar::before {
    opacity: 1;
  }

  html.z2 .site-head.is-compact .site-head-home {
    width: 168px;
  }

  html.z2 .site-head.is-compact .site-head-plate {
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.6),
      2px 3px 6px rgba(0, 0, 0, 0.5);
  }

  html.z2 .site-head.is-compact .site-head-subtitle {
    width: auto;
    margin-top: 0.4rem;
    font-size: 0.62rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  html.z2 .site-head.is-compact .site-head-rule {
    margin-top: 0.6rem;
  }

  @media (max-width: 640px) {
    html.z2 {
      scroll-padding-top: 5.5rem;
    }
    html.z2 .site-head-bar {
      padding-top: 1.5rem;
    }
    html.z2 .site-head-home {
      width: min(82%, 300px);
    }
    html.z2 .site-head-subtitle {
      width: min(82%, 300px);
      margin-top: 0.75rem;
      padding-left: 0.14em;
      font-size: 0.85rem;
      letter-spacing: 0.14em;
    }
    html.z2 .site-head-rule {
      margin-top: 1.75rem;
    }

    html.z2 .site-head.is-compact .site-head-bar {
      padding-top: 0.45rem;
    }
    html.z2 .site-head.is-compact .site-head-home {
      width: 120px;
    }
    html.z2 .site-head.is-compact .site-head-subtitle {
      margin-top: 0.25rem;
      font-size: 0.56rem;
      line-height: 1.35;
    }
    html.z2 .site-head.is-compact .site-head-rule {
      margin-top: 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.z2 .site-head-bar,
    html.z2 .site-head-bar::before,
    html.z2 .site-head-home,
    html.z2 .site-head-plate,
    html.z2 .site-head-subtitle,
    html.z2 .site-head-rule {
      transition: none;
    }
  }
</style>
