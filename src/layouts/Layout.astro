---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Low-tech, DIY, amateur astronomy hardware.',
  ogImage = '/logo_zUrp-astronomics.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://zurp-astronomics.github.io').toString();
const ogImageURL = new URL(ogImage, Astro.site ?? 'https://zurp-astronomics.github.io').toString();
const commitHash = import.meta.env.PUBLIC_COMMIT_HASH;
const buildDate = import.meta.env.PUBLIC_BUILD_DATE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="zUrp Astronomics" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;600;700&family=Russo+One&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <div class="build-stamp" aria-hidden="true">
      <code>{commitHash}</code>
      <span class="sep">·</span>
      <span>{buildDate}</span>
    </div>
  </body>
</html>

<style is:global>
  /*
   * Theme — aligned on the product posters: constructivist propaganda printed on cream paper,
   * pinned over a gridded blueprint. Navy grid = page ground, cream = paper panels, ink = text,
   * red = house accent. Product pages override --accent / --on-accent with the poster's colour.
   *
   * Rule: an accent is only ever a FILL, a BORDER or a SHADOW — never text on paper
   * (Basilisk green on cream is 2.3:1). Text on an accent fill uses --on-accent.
   */
  :root {
    --navy: #0b2a57;
    --navy-deep: #071c3d;
    --grid-minor: rgba(170, 200, 255, 0.07);
    --grid-major: rgba(170, 200, 255, 0.16);
    --paper: #f2e6c8;
    --paper-light: #f7eed6;
    --paper-shade: #e3d2a8;
    --ink: #1a1714;
    --ink-muted: #4f4536;
    --red: #c8141a;
    --accent: var(--red);
    --on-accent: var(--paper-light);
    --fg-on-navy: #f2e6c8;
    --fg-on-navy-muted: #b9c3d6;
    --rule: 3px solid var(--ink);
    --font-body: 'IBM Plex Sans', system-ui, sans-serif;
    --font-display: 'Russo One', 'Arial Black', 'IBM Plex Sans', sans-serif;
    --font-mono: 'IBM Plex Mono', 'SF Mono', Menlo, monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-body);
    color: var(--fg-on-navy);
    background-color: var(--navy);
    /* Blueprint grid: fine 24px cells, heavier line every 5 cells. */
    background-image:
      linear-gradient(var(--grid-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
      linear-gradient(var(--grid-minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
    background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    line-height: 1.6;
    font-weight: 400;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: opacity 0.15s ease;
  }

  a:hover {
    opacity: 0.75;
  }

  a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  code, pre, kbd, samp {
    font-family: var(--font-mono);
  }

  /* A paper sheet laid on the blueprint. */
  .paper {
    background: var(--paper);
    color: var(--ink);
    border: var(--rule);
    box-shadow: 8px 8px 0 var(--ink);
  }

  /* Visually hidden, still read by screen readers and crawlers. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .build-stamp {
    position: fixed;
    bottom: 0.5rem;
    right: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-on-navy-muted);
    opacity: 0.45;
    letter-spacing: 0.03em;
    pointer-events: none;
    user-select: none;
    z-index: 100;
    transition: opacity 0.2s ease;
  }

  .build-stamp:hover {
    opacity: 0.8;
  }

  .build-stamp code {
    color: var(--fg-on-navy);
    opacity: 0.8;
  }

  .build-stamp .sep {
    margin: 0 0.35rem;
    opacity: 0.5;
  }

  @media (max-width: 640px) {
    .build-stamp {
      display: none;
    }
  }
</style>
