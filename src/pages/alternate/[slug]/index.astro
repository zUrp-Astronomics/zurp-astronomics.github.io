---
// SOURCE: zurp-astronomics-site — /alternate/<slug>/ product page of the v1 archive: poster as header, tinted with the product accent
// AUTHOR: engineer
// DATE: 2026-10-03
// STATUS: archived — v1, frozen; only its route changed (it used to live at /<slug>/)
import { Image, getImage } from 'astro:assets';
import V1Layout from '../../../layouts/V1Layout.astro';
import { products } from '../../../data/products';
import { onAccent } from '../../../lib/color';

export function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;

const statusLabel = {
  wip: 'WIP',
  future: 'Future',
  released: 'Released',
};

// Social cards: the poster, as a JPEG (widest support among link unfurlers).
const ogPoster = await getImage({ src: product.poster, width: 1200, format: 'jpg', quality: 82 });

const tint = `--accent: ${product.accent}; --on-accent: ${onAccent(product.accent)};`;
---

<V1Layout
  title={`${product.name} — zUrp Astronomics`}
  description={product.tagline}
  ogImage={ogPoster.src}
>
  <div class="page" style={tint}>
    <header class="hero">
      <div class="container">
        <p class="breadcrumb">
          <a href="/alternate/">zUrp Astronomics</a>
          <span class="sep">/</span>
          <span class="current">{product.name}</span>
        </p>

        <!-- The poster is the page title: it carries the name. The h1 stays for a11y / SEO. -->
        <h1 class="sr-only">{product.name}</h1>
        <div class="poster-frame">
          <Image
            src={product.poster}
            alt={product.posterAlt}
            widths={[400, 640, 960, 1254]}
            sizes="(max-width: 700px) calc(100vw - 3rem), 640px"
            format="webp"
            quality={82}
            loading="eager"
            class="poster"
          />
        </div>

        <p class="tagline-mono">{product.category.toUpperCase()}</p>

        <div class="badges">
          <span class={`badge badge-${product.status}`}>{statusLabel[product.status]}</span>
          <span class="badge badge-license">GPL-3.0</span>
          {product.basedOn && <span class="badge badge-based">based on {product.basedOn}</span>}
        </div>
      </div>
    </header>

    <main class="container">
      <div class="sheet paper">
        <section class="lead">
          <p class="pitch">{product.tagline}</p>
        </section>

        <section class="description">
          <h2>About</h2>
          {product.description.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section class="repo">
          <h2>Source</h2>
          <a class="repo-link" href={product.repo}>
            <span class="repo-icon">⟶</span>
            <span class="repo-url">{product.repo.replace('https://github.com/', 'github.com/')}</span>
          </a>
          <p class="repo-note">
            Open hardware — BOM, 3D files, firmware, docs. All under GPL-3.0.
          </p>
        </section>
      </div>
    </main>

    <footer>
      <div class="container footer-inner">
        <p class="org-link">
          GitHub · <a href="https://github.com/zUrp-Astronomics">@zUrp-Astronomics</a>
        </p>
        <p><em>{product.name} — a product of zUrp Astronomics, a subsidiary of zUrp Industries.</em></p>
        <p class="legalese">
          Built with <a href="https://astro.build">Astro</a>, ~1&nbsp;MB of bash, and stubbornness.
          Hosted on GitHub Pages because the cloud is just someone else's keiretsu.
        </p>
      </div>
    </footer>
  </div>
</V1Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Accent rays behind the poster, fading into the blueprint. */
  .hero {
    background:
      radial-gradient(circle at 50% 42%, transparent 0 30%, var(--navy) 72%),
      repeating-conic-gradient(
        from 0deg at 50% 42%,
        color-mix(in srgb, var(--accent) 38%, transparent) 0deg 6deg,
        transparent 6deg 12deg
      );
    padding: 2.5rem 0 3rem;
    text-align: center;
    border-bottom: 6px solid var(--accent);
  }

  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-on-navy-muted);
    margin-bottom: 2rem;
    letter-spacing: 0.05em;
  }

  .breadcrumb a {
    color: var(--fg-on-navy-muted);
  }

  .breadcrumb .sep {
    margin: 0 0.5rem;
    opacity: 0.5;
  }

  .breadcrumb .current {
    color: var(--fg-on-navy);
  }

  /* Square, whole poster — never cropped: name, slogan and signature run to its edges. */
  .poster-frame {
    width: 100%;
    max-width: 640px;
    margin: 0 auto 2rem;
    border: 4px solid var(--ink);
    box-shadow: 10px 10px 0 var(--accent);
    background: var(--paper);
  }

  .poster {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
  }

  .tagline-mono {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.15em;
    color: var(--fg-on-navy);
    margin-bottom: 1.25rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .badge-wip {
    background: var(--accent);
    color: var(--on-accent);
  }

  .badge-future {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--paper-shade);
    box-shadow: 3px 3px 0 var(--accent);
  }

  .badge-released {
    background: #2f9e44;
    color: var(--paper-light);
  }

  .badge-license,
  .badge-based {
    background: var(--paper);
    color: var(--ink);
  }

  /* Accent band as an inset shadow: a thick border-top would mitre into the ink border. */
  .sheet {
    margin: 3rem 0 4rem;
    padding: 10px 2rem 0;
    box-shadow: inset 0 10px 0 var(--accent), 8px 8px 0 var(--ink);
  }

  section {
    padding: 2.5rem 0;
  }

  section + section {
    border-top: 2px dashed var(--ink-muted);
  }

  section h2 {
    width: fit-content;
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
    background: var(--accent);
    color: var(--on-accent);
    border: var(--rule);
    padding: 0.2rem 0.9rem;
  }

  .lead .pitch {
    font-size: 1.25rem;
    color: var(--ink);
    line-height: 1.5;
    max-width: 680px;
    font-weight: 600;
  }

  .description p {
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.2rem;
    max-width: 680px;
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    padding: 1rem 1.5rem;
    background: var(--accent);
    color: var(--on-accent);
    border: var(--rule);
    box-shadow: 5px 5px 0 var(--ink);
    font-family: var(--font-mono);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .repo-link:hover {
    opacity: 1;
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--ink);
  }

  .repo-url {
    font-size: 0.95rem;
  }

  .repo-note {
    margin-top: 1.25rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  footer {
    background: var(--navy-deep);
    border-top: 6px solid var(--ink);
    padding: 3rem 0;
    text-align: center;
  }

  .footer-inner p {
    color: var(--fg-on-navy-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .org-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem !important;
  }

  .org-link a {
    color: var(--fg-on-navy);
  }

  .legalese {
    font-size: 0.8rem !important;
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2rem 0 2.5rem;
    }
    .poster-frame {
      box-shadow: 6px 6px 0 var(--accent);
    }
    .sheet {
      padding: 0 1.25rem;
      margin: 2rem 0 3rem;
    }
    section {
      padding: 2rem 0;
    }
    section h2 {
      font-size: 1.3rem;
    }
    .lead .pitch {
      font-size: 1.1rem;
    }
  }
</style>
