---
// SOURCE: zurp-astronomics-site — /alternate/ home: second version of the site, series 2 posters, worn plate look
// AUTHOR: engineer
// DATE: 2026-10-03
// STATUS: active
//
// Same content as the v1 home (src/pages/index.astro): pitch, catalog, manifesto, footer. The copy
// is v1's, word for word; the catalog comes from products.ts. Do not reword it here: a change of
// copy belongs to both versions.
import AltLayout from '../../layouts/AltLayout.astro';
import PosterTile from '../../components/alternate/PosterTile.astro';
import { products } from '../../data/products';

const tiles = products.map((p) => ({
  name: p.name,
  tagline: p.tagline,
  href: `/alternate/${p.slug}/`,
  poster: p.poster2,
  posterAlt: p.poster2Alt,
  accent: p.accent2,
}));
---

<AltLayout title="zUrp Astronomics">
  <header class="hero">
    <div class="z2-container">
      <div class="hero-plate z2-plate">
        <div class="field">
          <div class="moon" aria-hidden="true"></div>
          <div class="nameplate">
            <h1>
              <img
                src="/logo_zUrp-astronomics.png"
                alt="zUrp Astronomics corporate logotype"
                class="logo"
                width="4000"
                height="1429"
              />
            </h1>
          </div>
        </div>
        <p class="tagline z2-slogan">Low-tech, DIY, amateur astronomy hardware.</p>
        <p class="pitch">
          We build astronomy gear with harmonic drives, 3D printers, and stubbornness.
          Open hardware by default, over-engineered by principle.
        </p>
        <p class="z2-signature hero-sig" aria-hidden="true"><span>zUrp Astronomics</span></p>
      </div>
    </div>
  </header>

  <main class="z2-container">
    <section class="catalog" aria-labelledby="catalog-title">
      <h2 id="catalog-title" class="z2-band section-title">Catalog</h2>
      <div class="grid">
        {tiles.map((t) => <PosterTile {...t} />)}
      </div>
    </section>

    <section class="manifesto z2-plate" aria-labelledby="manifesto-title">
      <h2 id="manifesto-title" class="z2-band section-title">Manifesto</h2>
      <p>
        Amateur astronomy, like open hardware, rewards patience. You don't ship a mount
        the month you think of it. You machine parts, mess up prints, tune harmonic drives
        at 2 a.m., and eventually point a camera at something 10&nbsp;million light-years away.
      </p>
      <p>
        We do it anyway, because the alternative is giving money to closed gear that breaks
        on warranty expiry. And because the sky doesn't care about our budget.
      </p>
    </section>
  </main>
</AltLayout>

<style>
  .hero {
    padding: 2.5rem 0 1rem;
  }

  /* The home page as one big worn plate: cream rim, blueprint field, moon, red rays. */
  .hero-plate {
    padding: 14px 14px 1.75rem;
    border-radius: 34px;
    text-align: center;
  }

  .field {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: clamp(260px, 42vw, 440px);
    padding: 2.5rem 1.25rem;
    border-radius: 22px 22px 6px 6px;
    background:
      /* worn print: grain + edge scuffs */
      radial-gradient(ellipse at 50% 50%, transparent 55%, rgba(16, 15, 14, 0.45) 100%),
      /* red rays fanning out from the moon */
      conic-gradient(
        from -8deg at 72% 38%,
        rgba(220, 42, 28, 0.92) 0deg 9deg,
        transparent 9deg 52deg,
        rgba(220, 42, 28, 0.92) 52deg 62deg,
        transparent 62deg 118deg,
        rgba(220, 42, 28, 0.92) 118deg 127deg,
        transparent 127deg 196deg,
        rgba(220, 42, 28, 0.92) 196deg 207deg,
        transparent 207deg 268deg,
        rgba(220, 42, 28, 0.92) 268deg 278deg,
        transparent 278deg 360deg
      ),
      /* blueprint grid */
      linear-gradient(rgba(220, 230, 255, 0.22) 1px, transparent 1px) 0 0 / 60px 60px,
      linear-gradient(90deg, rgba(220, 230, 255, 0.22) 1px, transparent 1px) 0 0 / 60px 60px,
      linear-gradient(rgba(220, 230, 255, 0.09) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(90deg, rgba(220, 230, 255, 0.09) 1px, transparent 1px) 0 0 / 12px 12px,
      radial-gradient(ellipse at 30% 30%, var(--z2-blueprint), var(--z2-blueprint-deep));
    box-shadow: inset 0 0 0 2px rgba(16, 15, 14, 0.6);
  }

  /* Ink wear over the field: a halftone screen and a grain layer. */
  .field::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--z2-halftone), var(--z2-grain);
    opacity: 0.35;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* A big pale moon with craters, as on every series 2 poster. */
  .moon {
    position: absolute;
    top: 38%;
    left: 72%;
    width: clamp(170px, 30vw, 340px);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 34%, rgba(70, 90, 130, 0.45) 0 7%, transparent 7.5%),
      radial-gradient(circle at 62% 26%, rgba(70, 90, 130, 0.35) 0 5%, transparent 5.5%),
      radial-gradient(circle at 55% 62%, rgba(70, 90, 130, 0.4) 0 11%, transparent 11.5%),
      radial-gradient(circle at 24% 66%, rgba(70, 90, 130, 0.3) 0 6%, transparent 6.5%),
      radial-gradient(circle at 78% 48%, rgba(70, 90, 130, 0.3) 0 4%, transparent 4.5%),
      radial-gradient(circle at 40% 38%, #f3e9cf, #ddd0ad 70%, #c7b98f);
    box-shadow: 0 0 60px rgba(243, 233, 207, 0.25);
  }

  /* The logo is black on white: it sits on a cream nameplate, multiplied into it. */
  .nameplate {
    position: relative;
    z-index: 1;
    width: min(100%, 600px);
    padding: 1.1rem 1.6rem;
    background:
      var(--z2-stains),
      var(--z2-cream);
    background-size: 600px 600px, auto;
    border-radius: 10px;
    box-shadow:
      0 0 0 3px var(--z2-soot-deep),
      8px 10px 0 rgba(16, 15, 14, 0.75);
    transform: rotate(-1.5deg);
  }

  .nameplate h1 {
    line-height: 0;
  }

  .logo {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    /* A touch of misregistration: the ink sits a hair off its own shadow. */
    filter: drop-shadow(2px 1px 0 rgba(220, 42, 28, 0.35));
  }

  .tagline {
    margin-top: 1.5rem;
    font-size: clamp(0.8rem, 2.2vw, 1.05rem);
  }

  .pitch {
    max-width: 640px;
    margin: 1.4rem auto 0;
    padding-inline: 0.75rem;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--z2-ink);
  }

  .hero-sig {
    max-width: 520px;
    margin: 1.4rem auto 0;
    color: var(--z2-ink);
    font-size: 0.9rem;
  }

  section {
    padding: 4.5rem 0 0;
  }

  .section-title {
    font-size: clamp(1.5rem, 7.5vw, 4.75rem);
    margin: 0 0 2.5rem -0.2rem;
  }

  .grid {
    display: grid;
    /* min() keeps a single column from overflowing narrow phones. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 2.75rem 2rem;
  }

  .manifesto {
    margin-top: 5.5rem;
    padding: 2.75rem 2.25rem 2rem;
  }

  /* The band straddles the plate's top rim. */
  .manifesto .section-title {
    margin-top: calc(-2.75rem - 0.8em);
  }

  .manifesto p {
    max-width: 720px;
    margin-bottom: 1.2rem;
    font-size: 1.07rem;
    color: var(--z2-ink);
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 1.25rem;
    }
    .hero-plate {
      padding: 10px 10px 1.4rem;
      border-radius: 24px;
    }
    .field {
      padding: 2rem 0.9rem;
      border-radius: 16px 16px 4px 4px;
    }
    .nameplate {
      padding: 0.8rem 1rem;
    }
    .pitch {
      font-size: 1rem;
    }
    section {
      padding-top: 3.5rem;
    }
    .manifesto {
      padding: 2.25rem 1.25rem 1.25rem;
    }
    .manifesto .section-title {
      margin-top: calc(-2.25rem - 0.8em);
    }
  }
</style>
