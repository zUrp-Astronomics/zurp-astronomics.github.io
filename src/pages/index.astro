---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

const cards = products.map((p) => ({
  name: p.name,
  tagline: p.tagline,
  href: `/${p.slug}/`,
  poster: p.poster,
  posterAlt: p.posterAlt,
  accent: p.accent,
}));
---

<Layout title="zUrp Astronomics">
  <header class="hero">
    <div class="container">
      <img
        src="/logo_zUrp-astronomics.png"
        alt="zUrp Astronomics corporate logotype"
        class="hero-logo"
      />
      <p class="tagline">Low-tech, DIY, amateur astronomy hardware.</p>
      <p class="pitch">
        We build astronomy gear with harmonic drives, 3D printers, and stubbornness.
        Open hardware by default, over-engineered by principle.
      </p>
    </div>
  </header>

  <main class="container">
    <section class="catalog">
      <h2 class="banner">Catalog</h2>
      <div class="grid">
        {cards.map((c) => <ProductCard {...c} />)}
      </div>
    </section>

    <section class="manifesto paper">
      <h2 class="banner">Manifesto</h2>
      <p>
        Amateur astronomy, like open hardware, rewards patience. You don't ship a mount
        the month you think of it. You machine parts, mess up prints, tune harmonic drives
        at 2 a.m., and eventually point a camera at something 10&nbsp;million light-years away.
      </p>
      <p>
        We do it anyway, because the alternative is giving money to closed gear that breaks
        on warranty expiry. And because the sky doesn't care about our budget.
      </p>
    </section>
  </main>

  <footer>
    <div class="container footer-inner">
      <p class="org-link">
        GitHub · <a href="https://github.com/zUrp-Astronomics">@zUrp-Astronomics</a>
      </p>
      <p><em>zUrp Astronomics — a subsidiary of zUrp Industries.</em></p>
      <p class="legalese">
        Built with <a href="https://astro.build">Astro</a>, ~1&nbsp;MB of bash, and stubbornness.
        Hosted on GitHub Pages because the cloud is just someone else's keiretsu.
      </p>
      <img
        src="/Low_tech_DIY.png"
        alt="Nyan Cat — Low-Tech & DIY internal sticker"
        class="easter-egg"
        title="Internal sticker — culture zUrp"
      />
    </div>
  </footer>
</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Cream sheet with the posters' sun rays fanning up from below. */
  .hero {
    background:
      repeating-conic-gradient(
        from 0deg at 50% 115%,
        var(--paper) 0deg 5deg,
        var(--paper-shade) 5deg 10deg
      );
    color: var(--ink);
    padding: 5rem 0 4.5rem;
    text-align: center;
    border-bottom: 6px solid var(--ink);
    box-shadow: 0 6px 0 var(--red);
  }

  .hero-logo {
    max-width: 520px;
    width: 80%;
    /* Black on white source: multiply drops the white onto the paper. */
    mix-blend-mode: multiply;
    margin-bottom: 2rem;
  }

  .tagline {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--red);
    color: var(--paper-light);
    border: var(--rule);
    box-shadow: 5px 5px 0 var(--ink);
    padding: 0.45rem 1.25rem;
    margin-bottom: 1.75rem;
  }

  .pitch {
    max-width: 620px;
    margin: 0 auto;
    font-size: 1.1rem;
    color: var(--ink);
  }

  section {
    padding: 4rem 0;
  }

  /* Section titles as poster banners. */
  .banner {
    display: inline-block;
    font-size: 2rem;
    background: var(--red);
    color: var(--paper-light);
    border: var(--rule);
    box-shadow: 6px 6px 0 var(--ink);
    padding: 0.3rem 1.1rem;
    margin-bottom: 2rem;
  }

  .grid {
    display: grid;
    /* min() keeps a single column from overflowing narrow phones. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.75rem;
  }

  .manifesto {
    padding: 2.5rem 2rem 1.5rem;
    margin-bottom: 4rem;
  }

  .manifesto p {
    max-width: 720px;
    margin-bottom: 1.2rem;
    color: var(--ink);
    font-size: 1.05rem;
  }

  footer {
    background: var(--navy-deep);
    border-top: 6px solid var(--ink);
    padding: 3rem 0;
    text-align: center;
  }

  .footer-inner p {
    color: var(--fg-on-navy-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .org-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem !important;
  }

  .org-link a {
    color: var(--fg-on-navy);
  }

  .legalese {
    font-size: 0.8rem !important;
    opacity: 0.8;
  }

  .easter-egg {
    max-width: 140px;
    margin-top: 1.5rem;
    opacity: 0.6;
    transition: opacity 0.2s ease, transform 0.2s ease;
    cursor: pointer;
  }

  .easter-egg:hover {
    opacity: 1;
    transform: scale(1.1) rotate(-2deg);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3.5rem 0 3rem;
    }
    .hero-logo {
      max-width: 300px;
      width: 90%;
    }
    .tagline {
      font-size: 0.95rem;
      letter-spacing: 0.08em;
    }
    section {
      padding: 3rem 0;
    }
    .banner {
      font-size: 1.6rem;
    }
    .manifesto {
      padding: 2rem 1.25rem 1rem;
      margin-bottom: 3rem;
    }
  }
</style>
